---
import Base from '../layouts/Base.astro';
import { getT } from '../i18n/utils';

const t = getT('en');
---

<Base lang="en" title={t.meta.title} description={t.meta.description}>
  <section class="mx-auto max-w-6xl px-4 py-24">
    <h1 class="font-display text-5xl font-bold">{t.hero.titleA}{t.hero.titleB}</h1>
    <p class="mt-4 text-mist">{t.meta.description}</p>
  </section>
</Base>
