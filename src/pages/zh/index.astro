---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/hero/Hero.astro';
import Proof from '../../components/bento/Proof.astro';
import Bento from '../../components/bento/Bento.astro';
import Themes from '../../components/themes/Themes.astro';
import YearReview from '../../components/review/YearReview.astro';
import HowItWorks from '../../components/how/HowItWorks.astro';
import QuickStart from '../../components/start/QuickStart.astro';
import Trust from '../../components/trust/Trust.astro';
import Faq from '../../components/faq/Faq.astro';
import { getT } from '../../i18n/utils';

const t = getT('zh');
---

<Base lang="zh" title={t.meta.title} description={t.meta.description} path="/zh/">
  <Hero t={t} lang="zh" />
  <Proof t={t} lang="zh" />
  <Bento t={t} lang="zh" />
  <Themes t={t} lang="zh" />
  <YearReview t={t} lang="zh" />
  <HowItWorks t={t} lang="zh" />
  <QuickStart t={t} lang="zh" />
  <Trust t={t} lang="zh" />
  <Faq t={t} lang="zh" />
</Base>
