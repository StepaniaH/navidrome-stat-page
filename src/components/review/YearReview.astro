---
import type { Language, Translation } from '../../i18n/utils';

interface Props {
  lang: Language;
  t: Translation;
}

const { t } = Astro.props;

const stats = [
  { value: 3847, label: t.review.plays, color: 'text-brand-orange' },
  { value: 412, label: t.review.hours, color: 'text-brand-lime' },
  { value: 486, label: t.review.artists, color: 'text-brand-cyan' },
  { value: 21, label: t.review.streak, color: 'text-frost' },
];
---

<section id="review" class="relative mt-24 scroll-mt-20 overflow-hidden border-y border-line/50">
  <div class="absolute inset-0 bg-gradient-to-b from-ink via-[#0f1728] to-ink" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{t.review.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-mist">{t.review.subtitle}</p>
    </div>

    <dl class="mx-auto mt-14 grid max-w-4xl grid-cols-2 gap-x-6 gap-y-10 text-center lg:grid-cols-4" data-reveal>
      {
        stats.map((stat) => (
          <div>
            <dd class={`font-display text-5xl font-bold tabular-nums tracking-tight sm:text-6xl ${stat.color}`} data-count={stat.value}>
              0
            </dd>
            <dt class="mt-2 text-sm text-mist">{stat.label}</dt>
          </div>
        ))
      }
    </dl>

    <div class="mx-auto mt-14 max-w-md" data-reveal>
      <p class="mb-3 text-center text-xs uppercase tracking-widest text-mist">{t.review.topTrack}</p>
      <div class="glass-card flex items-center gap-4 p-4">
        <span
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-navy font-display font-bold text-brand-cyan"
          aria-hidden="true">B</span
        >
        <div class="min-w-0 flex-1">
          <p class="truncate font-medium">Blue in Green</p>
          <div class="mt-2 h-1 overflow-hidden rounded-full bg-line">
            <div class="h-full w-[86%] rounded-full bg-brand-cyan"></div>
          </div>
        </div>
        <span class="font-mono text-xs text-mist">214</span>
      </div>
    </div>

    <div class="mt-12 text-center" data-reveal>
      <p class="text-sm text-mist/80">{t.review.disclaimer}</p>
      <button
        type="button"
        data-review-open
        class="mt-6 inline-flex cursor-pointer rounded-xl bg-brand-orange px-6 py-3 font-semibold text-ink transition-colors hover:bg-[#fb8b3c]"
      >
        {t.review.cta}
      </button>
    </div>
  </div>
</section>
