---
interface Props {
  idPrefix?: string;
  class?: string;
}

const { idPrefix = 'bm', class: className = 'h-8 w-8' } = Astro.props;
const wave = `${idPrefix}-wave`;
const trend = `${idPrefix}-trend`;
---

<svg viewBox="0 0 128 128" class={className} aria-hidden="true" fill="none">
  <defs>
    <linearGradient id={wave} gradientUnits="userSpaceOnUse" x1="50" y1="46" x2="38" y2="74">
      <stop offset="0" stop-color="#F97316"></stop>
      <stop offset="0.5" stop-color="#84CC16"></stop>
      <stop offset="1" stop-color="#22D3EE"></stop>
    </linearGradient>
    <linearGradient id={trend} gradientUnits="userSpaceOnUse" x1="66" y1="90" x2="102" y2="56">
      <stop offset="0" stop-color="#F97316"></stop>
      <stop offset="0.5" stop-color="#A3E635"></stop>
      <stop offset="1" stop-color="#38BDF8"></stop>
    </linearGradient>
  </defs>
  <path
    d="M 100.1 56.9 A 36.5 36.5 0 1 0 87.5 90"
    stroke="#DBE6F4"
    stroke-width="5"
    stroke-linecap="round"></path>
  <path d="M 50.69 60.36 A 13.5 13.5 0 0 0 45.55 72.18" stroke={`url(#${wave})`} stroke-width="5" stroke-linecap="round"></path>
  <path d="M 46.69 55.24 A 20 20 0 0 0 39.08 72.74" stroke={`url(#${wave})`} stroke-width="5" stroke-linecap="round"></path>
  <path d="M 42.68 50.12 A 26.5 26.5 0 0 0 32.60 73.31" stroke={`url(#${wave})`} stroke-width="5" stroke-linecap="round"></path>
  <circle cx="59" cy="71" r="8" fill="#FFFFFF" stroke="#DBE6F4" stroke-width="5"></circle>
  <circle cx="59" cy="71" r="2.2" fill="#DBE6F4"></circle>
  <path d="M 67 71 V 39.5" stroke="#DBE6F4" stroke-width="5" stroke-linecap="round"></path>
  <path d="M 67 39.5 L 82 45.5 V 56.5 L 67 50.5 Z" fill="#FFFFFF" stroke="#DBE6F4" stroke-width="5" stroke-linejoin="round"></path>
  <path d="M 69 98.5 H 103" stroke="#DBE6F4" stroke-width="4.5" stroke-linecap="round"></path>
  <rect x="70.5" y="89.5" width="7" height="9" rx="1.5" fill="#FFFFFF" stroke="#DBE6F4" stroke-width="4.5" stroke-linejoin="round"></rect>
  <rect x="82" y="82" width="7" height="16.5" rx="1.5" fill="#FFFFFF" stroke="#DBE6F4" stroke-width="4.5" stroke-linejoin="round"></rect>
  <rect x="93.5" y="75.5" width="7" height="23" rx="1.5" fill="#FFFFFF" stroke="#DBE6F4" stroke-width="4.5" stroke-linejoin="round"></rect>
  <path
    d="M 70.5 86.5 L 81 77.5 L 96.5 66.5"
    stroke={`url(#${trend})`}
    stroke-width="4.5"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle cx="70.5" cy="86.5" r="2.6" fill="#FFFFFF" stroke="#F97316" stroke-width="3.5"></circle>
  <circle cx="81" cy="77.5" r="2.6" fill="#FFFFFF" stroke="#84CC16" stroke-width="3.5"></circle>
  <circle cx="96.5" cy="66.5" r="4.5" fill="#FFFFFF" stroke="#38BDF8" stroke-width="4"></circle>
</svg>
