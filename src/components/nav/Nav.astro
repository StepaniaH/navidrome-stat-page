---
import { FUTURE_LANGUAGES, LANGUAGES, LINKS, SITE_VERSION } from '../../i18n/ui';
import { localePath, type Language, type Translation } from '../../i18n/utils';
import BrandMark from './BrandMark.astro';

interface Props {
  lang: Language;
  t: Translation;
}

const { lang, t } = Astro.props;

const links = [
  { href: '#features', label: t.nav.features },
  { href: '#themes', label: t.nav.themes },
  { href: '#review', label: t.nav.review },
  { href: '#quickstart', label: t.nav.start },
  { href: '#faq', label: t.nav.faq },
];
---

<header class="sticky top-0 z-50 border-b border-line/60 bg-ink/75 backdrop-blur-md">
  <nav aria-label="Main" class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6">
    <a href={localePath(lang, '/')} class="flex shrink-0 items-center gap-2.5">
      <BrandMark idPrefix="nav" class="h-8 w-8" />
      <span class="font-display text-lg font-semibold tracking-tight">Navidrome Stat</span>
      <span class="rounded-full border border-line bg-ink-2 px-2 py-0.5 font-mono text-[11px] text-mist">{SITE_VERSION}</span>
    </a>

    <ul class="ml-4 hidden items-center gap-5 text-sm text-mist lg:flex">
      {
        links.map((link) => (
          <li>
            <a class="transition-colors hover:text-frost" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          class="inline-flex items-center gap-1 transition-colors hover:text-frost"
          href={LINKS.docs}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.nav.docs}
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M5 3h8v8M13 3 3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
        </a>
      </li>
    </ul>

    <div class="ml-auto flex items-center self-stretch gap-2.5">
      <div class="relative hidden sm:flex items-center self-stretch" data-lang>
        <button
          type="button"
          data-lang-btn
          aria-haspopup="listbox"
          aria-expanded="false"
          class="flex items-center gap-1.5 rounded-lg border border-line bg-ink-2 px-2.5 py-1.5 text-sm text-mist transition-colors hover:text-frost"
        >
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.25"></circle>
            <path d="M1.75 8h12.5M8 1.75c1.8 1.7 2.7 3.85 2.7 6.25S9.8 12.55 8 14.25C6.2 12.55 5.3 10.4 5.3 8S6.2 3.45 8 1.75Z" stroke="currentColor" stroke-width="1.25"></path>
          </svg>
          {LANGUAGES[lang]}
          <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <div
          data-lang-menu
          role="listbox"
          aria-label={t.nav.language}
          class="invisible absolute right-0 top-full z-50 mt-2 w-48 rounded-xl border border-line bg-ink-2 p-1.5 opacity-0 shadow-xl shadow-black/40 transition-opacity duration-150"        >
          {
            (Object.keys(LANGUAGES) as Language[]).map((code) => (
              <a
                role="option"
                aria-selected={lang === code}
                href={localePath(code, '/')}
                class:list={[
                  'flex items-center justify-between rounded-lg px-3 py-2 text-sm transition-colors',
                  lang === code ? 'bg-brand-cyan/10 text-frost' : 'text-mist hover:bg-ink hover:text-frost',
                ]}
              >
                {LANGUAGES[code]}
                {lang === code && <svg class="h-3.5 w-3.5 text-brand-cyan" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>}
              </a>
            ))
          }
          <div class="my-1.5 border-t border-line"></div>
          {
            FUTURE_LANGUAGES.map((name) => (
              <span class="flex cursor-not-allowed items-center justify-between rounded-lg px-3 py-2 text-sm text-mist/40">
                {name}
                <span class="text-[10px] uppercase tracking-wide">{t.nav.soon}</span>
              </span>
            ))
          }
        </div>
      </div>

      <a
        href={LINKS.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="hidden rounded-lg border border-line bg-ink-2 p-2 text-mist transition-colors hover:text-frost sm:block"
      >
        <svg class="h-4.5 w-4.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
        </svg>
      </a>

      <a
        href="#quickstart"
        class="hidden rounded-lg bg-brand-orange px-3.5 py-1.5 text-sm font-semibold text-ink transition-colors hover:bg-[#fb8b3c] sm:inline-flex"
      >
        {t.nav.deploy}
      </a>

      <button
        type="button"
        data-menu-btn
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.menuOpen}
        data-label-open={t.nav.menuOpen}
        data-label-close={t.nav.menuClose}
        class="rounded-lg border border-line bg-ink-2 p-2 text-mist lg:hidden"
      >
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" data-menu-panel hidden class="border-t border-line/60 bg-ink/95 px-4 pb-5 pt-2 backdrop-blur-md lg:hidden">
    <ul class="flex flex-col text-sm">
      {
        links.map((link) => (
          <li>
            <a class="block rounded-lg px-3 py-2.5 text-mist transition-colors hover:bg-ink-2 hover:text-frost" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          class="flex items-center gap-1 rounded-lg px-3 py-2.5 text-mist transition-colors hover:bg-ink-2 hover:text-frost"
          href={LINKS.docs}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.nav.docs}
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M5 3h8v8M13 3 3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
        </a>
      </li>
    </ul>
    <div class="mt-3 flex items-center justify-between border-t border-line/60 pt-4">
      <div class="flex items-center gap-1 text-sm">
        <a
          href={localePath('en', '/')}
          aria-current={lang === 'en' ? 'true' : undefined}
          class:list={['rounded-lg px-2.5 py-1.5', lang === 'en' ? 'bg-brand-cyan/10 text-frost' : 'text-mist']}
        >
          English
        </a>
        <a
          href={localePath('zh', '/')}
          aria-current={lang === 'zh' ? 'true' : undefined}
          class:list={['rounded-lg px-2.5 py-1.5', lang === 'zh' ? 'bg-brand-cyan/10 text-frost' : 'text-mist']}
        >
          简体中文
        </a>
      </div>
      <a href="#quickstart" class="rounded-lg bg-brand-orange px-3.5 py-2 text-sm font-semibold text-ink">
        {t.nav.deploy}
      </a>
    </div>
  </div>
</header>
