---
import type { Language, Translation } from '../../i18n/utils';

interface Props {
  lang: Language;
  t: Translation;
}

const { t } = Astro.props;

const steps = [
  { n: '1', step: t.how.step1, icon: 'radio' },
  { n: '2', step: t.how.step2, icon: 'timer' },
  { n: '3', step: t.how.step3, icon: 'db' },
];
---

<section id="how" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{t.how.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-mist">{t.how.subtitle}</p>
    </div>

    <ol class="relative mt-14 grid gap-10 lg:grid-cols-3 lg:gap-8">
      <div class="absolute left-[16.6%] right-[16.6%] top-7 hidden border-t border-dashed border-line lg:block" aria-hidden="true"></div>
      {
        steps.map((item, index) => (
          <li class="relative text-center" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full border border-line bg-ink-2 font-display text-lg font-bold text-mist">
              {item.n}
            </div>
            <h3 class="mt-5 font-display text-lg font-semibold">{item.step.title}</h3>
            <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-mist">{item.step.desc}</p>
          </li>
        ))
      }
    </ol>

    <p class="mx-auto mt-12 max-w-2xl rounded-xl border border-line bg-ink-2/60 px-5 py-4 text-center text-sm text-mist" data-reveal>
      {t.how.note}
    </p>
  </div>
</section>
