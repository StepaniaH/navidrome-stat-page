---
import type { Language, Translation } from '../../i18n/utils';

interface Props {
  lang: Language;
  t: Translation;
}

const { t } = Astro.props;
---

<section class="relative border-y border-line/50 bg-ink-2/40" aria-label="Proof">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-10 gap-y-4 px-4 py-6 text-sm text-mist sm:px-6">
    <span class="inline-flex items-center gap-2">
      <svg class="h-4 w-4 text-brand-orange" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0ZM6.2 12.1V4.4h2.9c1.7 0 2.9 1 2.9 2.6 0 1.6-1.2 2.6-2.9 2.6H7.8v2.5H6.2Zm1.6-3.8h1.2c.8 0 1.4-.4 1.4-1.3 0-.9-.6-1.3-1.4-1.3H7.8v2.6Z"></path>
      </svg>
      {t.proof.ph}
    </span>
    <span class="inline-flex items-center gap-2">
      <svg class="h-4 w-4 text-brand-lime" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M5 2 3 6m8-4 2 4M3 6a2 2 0 1 0 4 0M3 6h4M9 6a2 2 0 1 0 4 0M9 6h4M8 2.5v9M5.5 14h5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      {t.proof.mit}
    </span>
    <span class="inline-flex items-center gap-2 font-mono text-xs">
      <svg class="h-4 w-4 text-brand-cyan" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M1 8.5h1.5v1.5H1V8.5Zm2.5 0H5v1.5H3.5V8.5Zm2.5 0h1.5v1.5H6V8.5Zm2.5 0H10v1.5H8.5V8.5ZM6 6.5h1.5V8H6V6.5Zm2.5 0H10V8H8.5V6.5Zm0-2H10V6H8.5v-1.5ZM14 8.5c-.4-.3-1.2-.4-1.8-.2-.1-.6-.4-1.1-.9-1.6l-.3-.2-.2.3c-.4.5-.5 1.3-.5 1.8-.4.3-1 .4-1.3.4H.6c.2 2.6 2.4 4.5 5.6 4.5 2.9 0 5.4-1.6 6.6-4.3.8 0 1.6-.2 2-.9l.2-.3-.3-.2c-.7-.4-1.6-.3-2.1 0l.4.7Z"></path>
      </svg>
      {t.proof.docker}
    </span>
    <span class="inline-flex items-center gap-2">
      <svg class="h-4 w-4 text-brand-orange" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="5" cy="4.5" r="2" stroke="currentColor" stroke-width="1.25"></circle>
        <circle cx="11" cy="6" r="2" stroke="currentColor" stroke-width="1.25"></circle>
        <path d="M2 13c.4-2.2 1.6-3.5 3-3.5S7.6 10.8 8 13M8.6 11.6c.5-1.4 1.4-2.1 2.4-2.1 1.3 0 2.4 1.2 2.9 3.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"></path>
      </svg>
      {t.proof.stack}
    </span>
  </div>
</section>
