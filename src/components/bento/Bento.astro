---
import { LANGUAGES } from '../../i18n/ui';
import type { Language, Translation } from '../../i18n/utils';

interface Props {
  lang: Language;
  t: Translation;
}

const { t } = Astro.props;

const demoRows = [
  { tile: 'B', tone: 'text-brand-orange', track: 'So What', meta: 'DSub · 2m ago' },
  { tile: 'T', tone: 'text-brand-cyan', track: 'Take Five', meta: 'Symfonium · 14m ago' },
  { tile: 'G', tone: 'text-brand-lime', track: 'Goodbye Pork Pie Hat', meta: 'Feishin · 31m ago' },
];

const themeDots = [
  { name: 'Latte', bg: '#EFF1F5', accent: '#7287FD' },
  { name: 'Frappé', bg: '#303446', accent: '#A6D189' },
  { name: 'Mocha', bg: '#1E1E2E', accent: '#B4BEFE' },
  { name: 'Dracula', bg: '#282A36', accent: '#BD93F9' },
  { name: 'Gruvbox', bg: '#282828', accent: '#FABD2F' },
];

const langChips = Object.values(LANGUAGES);
---

<section id="features" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
    <div class="max-w-2xl" data-reveal>
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{t.bento.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-mist">{t.bento.subtitle}</p>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      <!-- Now playing, live -->
      <article class="glass-card flex flex-col p-6 transition-colors hover:border-mist/30 lg:col-span-2" data-reveal>
        <div class="flex items-center gap-2 text-xs text-mist">
          <span class="pulse-dot h-2 w-2 rounded-full bg-brand-lime text-brand-lime"></span>
          {t.bento.np.title}
        </div>
        <ul class="mt-4 flex-1 space-y-3">
          {
            demoRows.map((row, i) => (
              <li class="flex items-center gap-3 rounded-xl border border-line/70 bg-ink/50 px-3.5 py-3">
                <span
                  class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-navy font-display text-sm font-bold ${row.tone}`}
                >
                  {row.tile}
                </span>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-medium">{row.track}</p>
                  <p class="truncate text-xs text-mist">{row.meta}</p>
                </div>
                <span class="flex h-5 items-end gap-[3px]" aria-hidden="true">
                  {[70, 45, 90].map((h, j) => (
                    <span
                      class={`eq-bar w-[3px] rounded-t-sm ${i === 0 ? 'bg-brand-lime/70' : 'bg-mist/30'}`}
                      style={`--i:${j + i * 3};height:${h}%`}
                    />
                  ))}
                </span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 flex items-center gap-2 border-t border-line/60 pt-3.5 text-xs text-mist">
          <span class="pulse-dot h-1.5 w-1.5 rounded-full bg-brand-lime text-brand-lime"></span>
          {t.bento.np.caption}
        </p>
      </article>

      <!-- Every client, one history -->
      <article class="glass-card flex flex-col p-6 transition-colors hover:border-mist/30" data-reveal style="--reveal-delay: 80ms">
        <h3 class="font-display text-lg font-semibold">{t.bento.aggregate.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-mist">{t.bento.aggregate.desc}</p>
        <svg class="mt-auto w-full pt-6" viewBox="0 0 300 190" fill="none" role="img" aria-label={t.bento.aggregate.title}>
          <defs>
            <linearGradient id="bento-wire" x1="0" y1="0" x2="1" y2="0">
              <stop stop-color="#8FA3BF" stop-opacity="0.25"></stop>
              <stop offset="0.5" stop-color="#22D3EE" stop-opacity="0.7"></stop>
              <stop offset="1" stop-color="#8FA3BF" stop-opacity="0.25"></stop>
            </linearGradient>
            <linearGradient id="bento-wire2" x1="0" y1="0" x2="1" y2="0">
              <stop stop-color="#8FA3BF" stop-opacity="0.2"></stop>
              <stop offset="1" stop-color="#22D3EE" stop-opacity="0.55"></stop>
            </linearGradient>
          </defs>

          <!-- client nodes -->
          <g font-family="var(--font-mono)" font-size="10" fill="#8FA3BF">
            <g>
              <rect x="6" y="28" width="86" height="30" rx="9" fill="#101A2E" stroke="#1D2C44"></rect>
              <circle cx="22" cy="43" r="3.5" fill="#F97316" fill-opacity="0.85"></circle>
              <text x="34" y="47">DSub</text>
            </g>
            <g>
              <rect x="6" y="78" width="86" height="30" rx="9" fill="#101A2E" stroke="#1D2C44"></rect>
              <circle cx="22" cy="93" r="3.5" fill="#22D3EE" fill-opacity="0.85"></circle>
              <text x="34" y="97">Symfonium</text>
            </g>
            <g>
              <rect x="6" y="128" width="86" height="30" rx="9" fill="#101A2E" stroke="#1D2C44"></rect>
              <circle cx="22" cy="143" r="3.5" fill="#A3E635" fill-opacity="0.85"></circle>
              <text x="34" y="147">Feishin</text>
            </g>
          </g>

          <!-- converging wires -->
          <path d="M92 43 C 132 43, 128 88, 158 92" stroke="url(#bento-wire)" stroke-width="1.6"></path>
          <path d="M92 93 C 116 93, 130 93, 158 93" stroke="url(#bento-wire)" stroke-width="1.6"></path>
          <path d="M92 143 C 132 143, 128 98, 158 94" stroke="url(#bento-wire)" stroke-width="1.6"></path>

          <!-- server hub -->
          <g>
            <rect x="158" y="70" width="60" height="46" rx="12" fill="#101A2E" stroke="#22D3EE" stroke-opacity="0.55" stroke-width="1.3"></rect>
            <g stroke="#8FA3BF" stroke-width="1.6" stroke-linecap="round">
              <path d="M170 84h36M170 92h36M170 100h24"></path>
            </g>
            <circle cx="196" cy="84" r="2" fill="#22D3EE"></circle>
            <circle cx="196" cy="92" r="2" fill="#22D3EE" fill-opacity="0.7"></circle>
            <text x="188" y="134" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="#8FA3BF">Navidrome</text>
          </g>

          <!-- wire to dashboard -->
          <path d="M218 93 C 240 93, 244 93, 256 93" stroke="url(#bento-wire2)" stroke-width="1.6"></path>
          <path d="m252 88.5 5.5 4.5-5.5 4.5" stroke="#22D3EE" stroke-opacity="0.7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>

          <!-- dashboard node -->
          <g>
            <rect x="260" y="68" width="34" height="50" rx="9" fill="#101A2E" stroke="#1D2C44"></rect>
            <g fill="#22D3EE">
              <rect x="265" y="98" width="5" height="12" rx="1" fill-opacity="0.9"></rect>
              <rect x="273" y="90" width="5" height="20" rx="1" fill-opacity="0.7"></rect>
              <rect x="281" y="82" width="5" height="28" rx="1" fill-opacity="0.85"></rect>
            </g>
            <text x="277" y="134" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="#8FA3BF">Stat</text>
          </g>
        </svg>
      </article>

      <!-- Charts -->
      <article class="glass-card flex flex-col p-6 transition-colors hover:border-mist/30" data-reveal>
        <h3 class="font-display text-lg font-semibold">{t.bento.charts.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-mist">{t.bento.charts.desc}</p>
        <div class="mt-auto flex flex-col gap-5 pt-6" aria-hidden="true">
          <div class="flex h-20 items-end gap-1.5 rounded-lg border border-line/70 bg-ink/50 px-3 pb-2 pt-3">
            {
              [34, 52, 40, 66, 58, 84, 72, 95, 62, 78, 48, 70].map((h, i) => (
                <span
                  class={`flex-1 rounded-t-sm ${i === 7 ? 'bg-brand-cyan' : 'bg-mist/25'}`}
                  style={`height:${h}%`}
                />
              ))
            }
          </div>
          <div class="grid grid-cols-12 gap-[3px] rounded-lg border border-line/70 bg-ink/50 p-3">
            {Array.from({ length: 60 }, (_, i) => {
              const v = ((i * 37) % 19) / 19;
              const a = (0.08 + v * 0.55).toFixed(2);
              return <span class="aspect-square rounded-[2px]" style={`background:rgba(34,211,238,${a})`} />;
            })}
          </div>
        </div>
      </article>

      <!-- Year in review -->
      <article class="glass-card flex flex-col p-6 transition-colors hover:border-mist/30" data-reveal style="--reveal-delay: 80ms">
        <h3 class="font-display text-lg font-semibold">{t.bento.review.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-mist">{t.bento.review.desc}</p>
        <dl class="mt-5 grid flex-1 grid-cols-3 content-center gap-2.5 text-center">
          <div class="rounded-xl border border-line bg-ink/60 px-2 py-4">
            <dd class="font-mono text-sm font-medium tabular-nums text-brand-lime">3,847</dd>
            <dt class="mt-1 text-[11px] leading-tight text-mist">{t.review.plays}</dt>
          </div>
          <div class="rounded-xl border border-line bg-ink/60 px-2 py-4">
            <dd class="font-mono text-sm font-medium tabular-nums text-brand-cyan">412</dd>
            <dt class="mt-1 text-[11px] leading-tight text-mist">{t.review.hours}</dt>
          </div>
          <div class="rounded-xl border border-line bg-ink/60 px-2 py-4">
            <dd class="font-mono text-sm font-medium tabular-nums text-brand-orange">21</dd>
            <dt class="mt-1 text-[11px] leading-tight text-mist">{t.review.streak}</dt>
          </div>
        </dl>
        <p class="mt-5 border-t border-line/60 pt-3.5 text-right">
          <a href="#review" class="text-xs text-mist transition-colors hover:text-frost">→ {t.nav.review}</a>
        </p>
      </article>

      <!-- Cover art -->
      <article class="glass-card flex flex-col p-6 transition-colors hover:border-mist/30" data-reveal style="--reveal-delay: 160ms">
        <h3 class="font-display text-lg font-semibold">{t.bento.cover.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-mist">{t.bento.cover.desc}</p>
        <div class="grid flex-1 grid-cols-4 content-center gap-3" aria-hidden="true">
          <span class="flex aspect-square items-center justify-center rounded-xl bg-navy font-display text-xl font-bold text-brand-orange">K</span>
          <span class="flex aspect-square items-center justify-center rounded-xl bg-navy font-display text-xl font-bold text-brand-cyan">B</span>
          <span class="flex aspect-square items-center justify-center rounded-xl bg-navy font-display text-xl font-bold text-brand-lime">A</span>
          <span class="flex aspect-square items-center justify-center rounded-xl border border-dashed border-line font-display text-xl font-bold text-mist">?</span>
        </div>
        <p class="mt-5 flex items-center gap-2 border-t border-line/60 pt-3.5 font-mono text-[11px] text-mist">
          <svg class="h-3.5 w-3.5 text-brand-cyan" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 2 4 4.5v4c0 3.6 2.4 6.9 6 8 3.6-1.1 6-4.4 6-8v-4L10 2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
            <path d="m7.5 9.8 1.8 1.8 3.2-3.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {t.bento.cover.caption}
        </p>
      </article>

      <!-- Privacy (wide) -->
      <article class="glass-card p-6 transition-colors hover:border-mist/30 lg:col-span-2" data-reveal>
        <div class="flex items-start gap-4">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-cyan/10 text-brand-cyan">
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M10 2 4 4.5v4c0 3.6 2.4 6.9 6 8 3.6-1.1 6-4.4 6-8v-4L10 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
              <path d="m7.5 9.8 1.8 1.8 3.2-3.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
          <div>
            <h3 class="font-display text-lg font-semibold">{t.bento.privacy.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-mist">{t.bento.privacy.desc}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {
                t.bento.privacy.points.map((point) => (
                  <span class="rounded-full border border-line bg-ink/60 px-3 py-1 text-xs text-frost">{point}</span>
                ))
              }
            </div>
          </div>
        </div>
      </article>

      <!-- Themes -->
      <article class="glass-card flex flex-col p-6 transition-colors hover:border-mist/30" data-reveal style="--reveal-delay: 80ms">
        <h3 class="font-display text-lg font-semibold">{t.bento.themesCard.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-mist">{t.bento.themesCard.desc}</p>
        <div class="mt-auto flex items-center gap-2 pt-6">
          {
            themeDots.map((dot) => (
              <a
                href="#themes"
                title={dot.name}
                class="h-6 w-6 rounded-full border border-line transition-transform hover:scale-110"
                style={`background:${dot.bg};box-shadow:inset 0 0 0 2px ${dot.accent}`}
              />
            ))
          }
          <a href="#themes" class="ml-auto text-xs text-mist transition-colors hover:text-frost">→ {t.nav.themes}</a>
        </div>
      </article>

      <!-- Languages (slim, full width) -->
      <article
        class="glass-card flex flex-col gap-4 p-6 transition-colors hover:border-mist/30 md:col-span-2 lg:col-span-3 lg:flex-row lg:items-center"
        data-reveal
      >
        <div class="lg:w-1/3">
          <h3 class="font-display text-lg font-semibold">{t.bento.langs.title}</h3>
        </div>
        <p class="text-sm leading-relaxed text-mist lg:w-2/5">{t.bento.langs.desc}</p>
        <div class="flex flex-wrap gap-2 lg:ml-auto">
          {
            langChips.map((chip) => (
              <span class="rounded-lg border border-line bg-ink/60 px-3 py-1.5 text-sm text-frost">{chip}</span>
            ))
          }
        </div>
      </article>
    </div>
  </div>
</section>
