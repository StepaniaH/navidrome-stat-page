---
import type { Language, Translation } from '../../i18n/utils';

interface Props {
  lang: Language;
  t: Translation;
}

const { t } = Astro.props;
---

<section id="trust" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
    <div class="grid gap-5 lg:grid-cols-2">
      <article class="glass-card p-7" data-reveal>
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-lime/10 text-brand-lime">
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M10 2 4 4.5v4c0 3.6 2.4 6.9 6 8 3.6-1.1 6-4.4 6-8v-4L10 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
            </svg>
          </span>
          <h2 class="font-display text-xl font-semibold">{t.trust.privacyTitle}</h2>
        </div>
        <ul class="mt-6 space-y-5">
          {
            t.trust.privacyItems.map((item) => (
              <li class="flex gap-3">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-lime" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.25" />
                  <path d="m5 8.2 2 2 4-4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div>
                  <h3 class="text-sm font-semibold">{item.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-mist">{item.desc}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="glass-card p-7" data-reveal style="--reveal-delay: 90ms">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-orange/10 text-brand-orange">
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M10 9v4.5M10 16.2v.05" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
              <path d="M10 2.5 18 17H2L10 2.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
            </svg>
          </span>
          <h2 class="font-display text-xl font-semibold">{t.trust.limitsTitle}</h2>
        </div>
        <ul class="mt-6 space-y-5">
          {
            t.trust.limitItems.map((item) => (
              <li class="flex gap-3">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-orange" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.25" />
                  <path d="M8 7.2v3.3M8 5.2v.05" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                </svg>
                <div>
                  <h3 class="text-sm font-semibold">{item.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-mist">{item.desc}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </div>
</section>
