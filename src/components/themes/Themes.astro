---
import type { Language, Translation } from '../../i18n/utils';

interface Props {
  lang: Language;
  t: Translation;
}

const { t } = Astro.props;

const palettes = [
  { name: 'Catppuccin Latte', bg: '#EFF1F5', accent: '#8839EF' },
  { name: 'Catppuccin Frappé', bg: '#303446', accent: '#CA9EE6' },
  { name: 'Catppuccin Macchiato', bg: '#24273A', accent: '#B7BDF8' },
  { name: 'Catppuccin Mocha', bg: '#1E1E2E', accent: '#CBA6F7' },
  { name: 'Nord', bg: '#2E3440', accent: '#88C0D0' },
  { name: 'Dracula', bg: '#282A36', accent: '#BD93F9' },
  { name: 'Tokyo Night', bg: '#1A1B26', accent: '#7AA2F7' },
  { name: 'Gruvbox', bg: '#282828', accent: '#FABD2F' },
  { name: 'Solarized Dark', bg: '#002B36', accent: '#268BD2' },
  { name: 'Solarized Light', bg: '#FDF6E3', accent: '#B58900' },
];
---

<section id="themes" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
    <div class="max-w-2xl" data-reveal>
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{t.themes.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-mist">{t.themes.subtitle}</p>
    </div>

    <div class="mt-10 overflow-hidden rounded-2xl border border-line bg-ink-2 shadow-2xl shadow-black/30" data-reveal>
      <div class="flex items-center gap-3 border-b border-line/70 bg-ink px-4 py-3">
        <span class="flex gap-1.5" aria-hidden="true">
          <span class="h-3 w-3 rounded-full bg-[#FF5F57]"></span>
          <span class="h-3 w-3 rounded-full bg-[#FEBC2E]"></span>
          <span class="h-3 w-3 rounded-full bg-[#28C840]"></span>
        </span>
        <span class="mx-auto flex items-center gap-2 rounded-lg bg-ink-2 px-4 py-1 font-mono text-xs text-mist">
          <svg class="h-3 w-3 text-brand-lime" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <rect x="2.5" y="5" width="7" height="5.5" rx="1" stroke="currentColor" stroke-width="1.1"></rect>
            <path d="M4 5V4a2 2 0 1 1 4 0v1" stroke="currentColor" stroke-width="1.1"></path>
          </svg>
          {t.themes.urlLabel}
        </span>
        <span class="w-14" aria-hidden="true"></span>
      </div>

      <div class="relative aspect-[16/9]">
        <img
          data-theme-panel="frappe"
          src="/screenshots/dashboard-frappe-top.webp"
          alt={t.themes.alt.replace('{name}', t.themes.frappe)}
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover object-top"
        />
        <img
          data-theme-panel="gruvbox"
          src="/screenshots/dashboard-gruvbox.webp"
          alt={t.themes.alt.replace('{name}', t.themes.gruvbox)}
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover object-top"
          hidden
        />
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-4" data-reveal>
      <div class="flex gap-2" role="tablist" aria-label={t.themes.title}>
        <button type="button" role="tab" aria-selected="true" data-theme-btn="frappe" class="tab-btn">
          {t.themes.frappe}
        </button>
        <button type="button" role="tab" aria-selected="false" data-theme-btn="gruvbox" class="tab-btn">
          {t.themes.gruvbox}
        </button>
      </div>

      <div class="ml-auto flex flex-wrap items-center gap-2.5">
        <span class="mr-1 text-xs text-mist">{t.themes.paletteNote}</span>
        {
          palettes.map((palette) => (
            <span
              class="h-6 w-6 rounded-full border border-line/80 transition-transform hover:scale-110"
              title={palette.name}
              style={`background:${palette.bg};box-shadow:inset 0 0 0 2px ${palette.accent}`}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
