---
import { Font } from 'astro:assets';
import notoScCss from '../styles/noto-sc.css?url';
import '../styles/global.css';

import Nav from '../components/nav/Nav.astro';
import Footer from '../components/footer/Footer.astro';
import { LANGUAGES, LINKS, SITE_VERSION } from '../i18n/ui';
import { getT, localePath, type Language } from '../i18n/utils';

interface Props {
  lang: Language;
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
}

const { lang, title, description, path = '/', noindex = false } = Astro.props;
const t = getT(lang);
const site = Astro.site ?? new URL('https://navidrome-stat.pages.dev');
const canonical = new URL(localePath(lang, path), site);
const altHrefs = Object.keys(LANGUAGES).map((code) => ({
  code,
  href: new URL(localePath(code as Language, path), site).href,
}));

const HTML_LANG: Record<Language, string> = {
  en: 'en',
  zh: 'zh-CN',
  'zh-TW': 'zh-TW',
  ja: 'ja',
  fr: 'fr',
  es: 'es',
};

const OG_LOCALE: Record<Language, string> = {
  en: 'en_US',
  zh: 'zh_CN',
  'zh-TW': 'zh_TW',
  ja: 'ja_JP',
  fr: 'fr_FR',
  es: 'es_ES',
};

const OG_IMAGE: Record<Language, string> = {
  en: '/og.png',
  zh: '/og-zh.png',
  'zh-TW': '/og-zh-TW.png',
  ja: '/og-ja.png',
  fr: '/og-fr.png',
  es: '/og-es.png',
};

const ogImage = new URL(OG_IMAGE[lang], site).href;
const ogAlternates = Object.keys(LANGUAGES)
  .filter((code) => code !== lang)
  .map((code) => OG_LOCALE[code as Language]);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Navidrome Stat',
  alternateName: 'Navidrome Statistic',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Docker, Linux',
  softwareVersion: SITE_VERSION.replace('v', ''),
  license: LINKS.license,
  url: LINKS.github,
  author: { '@type': 'Person', name: 'StepaniaH', url: 'https://github.com/StepaniaH' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical.href} />
    {
      altHrefs.map((alt) => (
        <link rel="alternate" hreflang={HTML_LANG[alt.code as Language]} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={altHrefs[0].href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b1220" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Navidrome Stat" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {ogAlternates.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogImageAlt} />
    <link rel="preload" as="style" href={notoScCss} />
    <link rel="stylesheet" href={notoScCss} media="print" data-async-css />
    <noscript><link rel="stylesheet" href={notoScCss} /></noscript>
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline src="/motion.js" defer></script>
  </head>
  <body class="min-h-screen bg-ink font-body text-frost">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-ink-2 focus:px-4 focus:py-2 focus:text-sm"
    >
      {t.nav.skip}
    </a>
    <Nav t={t} lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer t={t} lang={lang} />
  </body>
</html>
